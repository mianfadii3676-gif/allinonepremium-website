{
  "name": "Allinonepermium Admin",
  "short_name": "AOP Admin",
  "description": "Manage orders, products and customers for Allinonepermium.",
  "id": "/admin",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#070b16",
  "theme_color": "#070b16",
  "icons": [
    { "src": "/admin-icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/admin-icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/admin-icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Orders", "url": "/admin/orders?status=pending", "icons": [{ "src": "/admin-icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New manual order", "url": "/admin/orders/new", "icons": [{ "src": "/admin-icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
